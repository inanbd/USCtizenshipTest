@page "/flashcards"
@attribute [Authorize]
@inject CivicsApiClient Api

<PageTitle>Flashcards — Civics Prep</PageTitle>

<h1>Flashcards</h1>

@if (_error is not null)
{
    <p class="alert alert-error">@_error</p>
}
else if (_cards is null)
{
    <p class="loading">Loading cards…</p>
}
else if (_cards.Count == 0)
{
    <div class="card"><p class="muted" style="margin:0">No cards in this set.</p></div>
}
else
{
    var card = _cards[_index];

    <div class="card">
        <div class="spread">
            <span class="muted small">@(_index + 1) / @_cards.Count</span>
            <label class="row small" style="margin:0;font-weight:500">
                <input type="checkbox" checked="@_seniorOnly" @onchange="ToggleSeniorAsync"
                       style="width:auto" />
                65/20 only
            </label>
        </div>
    </div>

    <div class="card flashcard" @onclick="Flip">
        @if (_flipped)
        {
            <div>
                @if (card.NeedsUserData)
                {
                    <p class="alert alert-info">
                        This answer depends on your state. <a href="settings">Set it here</a>.
                    </p>
                }
                else
                {
                    <ul class="answers" style="list-style:none;padding:0">
                        @foreach (var a in card.Answers)
                        {
                            <li><strong>@a</strong></li>
                        }
                    </ul>
                }
                @if (card.RequiredCount > 1)
                {
                    <p class="muted small">Give @card.RequiredCount answers.</p>
                }
                <p class="muted small">Tap to flip back</p>
            </div>
        }
        else
        {
            <div>
                <p class="muted small" style="margin:0 0 .5rem">Q@card.Number</p>
                <h2>@card.Prompt</h2>
                <p class="muted small">Tap to flip</p>
            </div>
        }
    </div>

    <div class="row" style="margin-top:1rem">
        <button class="btn btn-ghost" @onclick="Previous" disabled="@(_index == 0)">Previous</button>
        <button class="btn btn-primary" @onclick="Next"
                disabled="@(_index >= _cards.Count - 1)">Next</button>
        <span style="flex:1"></span>
        <button class="btn btn-ghost" @onclick="() => SetFavoriteAsync(card)">
            @(card.IsFavorite ? "★ Starred" : "☆ Star")
        </button>
        <button class="btn btn-secondary" @onclick="() => SetLearnedAsync(card)">
            @(card.IsLearned ? "✓ Known" : "Mark known")
        </button>
    </div>
}

@code {
    private List<QuestionDto>? _cards;
    private string? _error;
    private int _index;
    private bool _flipped;
    private bool _seniorOnly;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _error = null;
            var list = await Api.GetQuestionsAsync(filter: _seniorOnly ? "Senior" : "All");
            _cards = [.. list.Questions];
            if (_index >= _cards.Count) _index = 0;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private void Flip() => _flipped = !_flipped;

    private void Next()
    {
        if (_cards is null || _index >= _cards.Count - 1) return;
        _index++;
        _flipped = false;   // each card starts on its question side
    }

    private void Previous()
    {
        if (_index == 0) return;
        _index--;
        _flipped = false;
    }

    private async Task ToggleSeniorAsync(ChangeEventArgs e)
    {
        _seniorOnly = (bool?)e.Value ?? false;
        _index = 0;
        _flipped = false;
        await LoadAsync();
    }

    private async Task SetLearnedAsync(QuestionDto card)
    {
        await Api.SetQuestionProgressAsync(card.Number, !card.IsLearned, null);
        await LoadAsync();
    }

    private async Task SetFavoriteAsync(QuestionDto card)
    {
        await Api.SetQuestionProgressAsync(card.Number, null, !card.IsFavorite);
        await LoadAsync();
    }
}
